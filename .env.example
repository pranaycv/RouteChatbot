# Copy to .env and fill in locally. .env is git-ignored.
OPENAI_API_KEY=
OPENROUTER_API_KEY=
MAPBOX_TOKEN=
GRAPHHOPPER_KEY=

# STUBS=1 runs the week-1 stub for every stage.
# FIXTURES=replay reads recorded API responses; FIXTURES=record saves them.
# CLASSIFIER_BACKEND is ft, base, prompted_small, or prompted_large (WP2).
STUBS=
FIXTURES=
CLASSIFIER_BACKEND=
